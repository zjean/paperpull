# Copy to .env and fill in. `docker compose` reads .env automatically.
# .env is gitignored — it holds a password that guards a signed-in browser.

TZ=Europe/Amsterdam

# --- file ownership ------------------------------------------------------
# Who owns everything the containers write: the downloaded PDFs, the index
# CSVs, the configs, the browser profile. Set these to your own values and
# your statements are readable on the host without sudo:
#
#     id -u    ->  PUID
#     id -g    ->  PGID
#
# Both containers use this same pair, and they must: Chrome writes downloads
# into a directory the other container created mode 0700, so a mismatch turns
# every PDF into a zero-byte file rather than raising an error.
#
# Whatever you set here, `chown` the three bind-mounted directories to match
# before the first start:
#     sudo chown -R $PUID:$PGID config data browser-profile
PUID=1000
PGID=1000

# --- the browser desktop -------------------------------------------------
# Login for the Chrome desktop. Whoever gets past this reaches a browser that
# is signed in to your accounts, so give it a real password, not "chrome".
BROWSER_USER=paperpull
BROWSER_PASSWORD=

# --- the control panel ---------------------------------------------------
# The hostname your reverse proxy serves the panel on. Comma-separated if
# more than one. Requests from any other host are refused as cross-origin;
# localhost is always allowed and does not need listing.
PAPERPULL_ALLOWED_HOSTS=paperpull.example.com

# Public URL of the browser desktop, used for the panel's
# "Open browser desktop" link. Leave empty to hide the link.
PAPERPULL_BROWSER_URL=https://browser.example.com/

# --- image ---------------------------------------------------------------
# :latest tracks main, :beta tracks develop. Or comment `image` and
# uncomment `build: .` in docker-compose.yml to run your working tree.
PAPERPULL_IMAGE=ghcr.io/zjean/paperpull:latest
PAPERPULL_BROWSER_IMAGE=ghcr.io/zjean/paperpull-browser:latest
